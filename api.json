{
  "info": {
    "name": "OTT Community FULL API",
    "_postman_id": "full-mysql-api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "OTT File Attachments",
      "item": [
        {
          "name": "POST get presigned upload URL",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"keyPrefix\": \"uploads\",\n  \"contentType\": \"image/png\"\n}"
            },
            "url": "{{baseUrl}}/api/uploads/presigned-url",
            "description": "Step 1: create a presigned PUT URL. Save uploadUrl, uploadKey, and uploadBucket into environment variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.environment.set('uploadUrl', json.uploadUrl);",
                  "pm.environment.set('uploadKey', json.key);",
                  "pm.environment.set('uploadBucket', json.bucket);",
                  "pm.test('presigned url returned', function () {",
                  "  pm.expect(json.uploadUrl).to.be.a('string');",
                  "  pm.expect(json.key).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT upload file to S3",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "image/png" }],
            "body": {
              "mode": "file"
            },
            "url": "{{uploadUrl}}",
            "description": "Step 2: use the uploadUrl returned by the previous request. In Postman, set Body to binary/file and choose a local file manually."
          }
        },
        {
          "name": "POST send attached channel message",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"channel:1\",\n  \"senderId\": 12,\n  \"contentType\": \"image\",\n  \"content\": \"\",\n  \"attachments\": [\n    {\n      \"url\": \"https://{{uploadBucket}}.s3.ap-southeast-1.amazonaws.com/{{uploadKey}}\",\n      \"key\": \"{{uploadKey}}\",\n      \"name\": \"sample-image.png\",\n      \"mimeType\": \"image/png\",\n      \"size\": 245678\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/messages",
            "description": "Step 3: save the uploaded file as a message attachment. You can also switch this request to /api/messages/channel or /api/messages/direct."
          }
        },
        {
          "name": "GET verify channel messages",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/messages/conversations/channel:1",
            "description": "Step 4: confirm that the attached message was persisted in DynamoDB."
          }
        }
      ]
    },
