{
	"info": {
		"name": "OTT Community - Group API Test",
		"_postman_id": "ott-community-group-api",
		"description": "Collection test cho API tạo nhóm, thêm thành viên qua link và QR (không cần import environment riêng)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:4000/api"
		},
		{
			"key": "jwtToken",
			"value": ""
		},
		{
			"key": "userId",
			"value": ""
		},
		{
			"key": "groupId",
			"value": ""
		},
		{
			"key": "inviteCode",
			"value": ""
		},
		{
			"key": "inviteLink",
			"value": ""
		}
	],
	"item": [
		{
			"name": "1. Login - Lấy JWT Token",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Không cần prerequest cho login"
						],
						"type": "text/javascript"
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.token) {",
							"    pm.collectionVariables.set('jwtToken', jsonData.token);",
							"}",
							"if (jsonData.user) {",
							"    pm.collectionVariables.set('userId', jsonData.user.userId || jsonData.user.userId);",
							"} else if (jsonData.userId) {",
							"    pm.collectionVariables.set('userId', jsonData.userId);",
							"}",
							"",
							"pm.test('Response has token', function () {",
							"    pm.expect(jsonData).to.have.property('token');",
							"});",
							"",
							"pm.test('Status is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"console.log('Token:', pm.collectionVariables.get('jwtToken'));",
							"console.log('UserID:', pm.collectionVariables.get('userId'));"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"username\": \"testuser\",\n    \"password\": \"testpass\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/auth/login"
			}
		},
		{
			"name": "2. Tạo nhóm chat mới",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.collectionVariables.set('groupId', jsonData.groupId);",
							"pm.collectionVariables.set('inviteCode', jsonData.inviteCode);",
							"",
							"pm.test('Group created successfully', function () {",
							"    pm.expect(jsonData).to.have.property('groupId');",
							"    pm.expect(jsonData).to.have.property('name');",
							"    pm.expect(jsonData).to.have.property('inviteCode');",
							"    pm.expect(jsonData.inviteCode).to.have.lengthOf(6);",
							"});",
							"",
							"pm.test('Status is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"console.log('=== GROUP CREATED ===');",
							"console.log('Group ID:', jsonData.groupId);",
							"console.log('Invite Code:', jsonData.inviteCode);",
							"console.log('=====================');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Nhóm Test {{$timestamp}}\",\n    \"description\": \"Nhóm test tự động\",\n    \"createdBy\": \"{{userId}}\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/groups"
			}
		},
		{
			"name": "3. Lấy thông tin nhóm theo ID",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"",
							"pm.test('Group found', function () {",
							"    pm.expect(jsonData).to.have.property('groupId');",
							"    pm.expect(jsonData).to.have.property('name');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/groups/{{groupId}}"
			}
		},
		{
			"name": "4. Lấy link mời tham gia nhóm (tạo QR)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"pm.collectionVariables.set('inviteCode', jsonData.inviteCode);",
							"pm.collectionVariables.set('inviteLink', jsonData.inviteLink);",
							"",
							"pm.test('Invite link generated', function () {",
							"    pm.expect(jsonData).to.have.property('inviteCode');",
							"    pm.expect(jsonData).to.have.property('inviteLink');",
							"    pm.expect(jsonData.inviteLink).to.include('/join/');",
							"});",
							"",
							"pm.test('Status is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"console.log('======================================');",
							"console.log('INVITE LINK (paste vào QR generator):');",
							"console.log(jsonData.inviteLink);",
							"console.log('======================================');",
							"console.log('INVITE CODE:', jsonData.inviteCode);",
							"console.log('======================================');"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/groups/{{groupId}}/invite"
			}
		},
		{
			"name": "5. Tham gia nhóm qua invite code (quét QR)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"",
							"pm.test('Joined group successfully', function () {",
							"    pm.expect(jsonData).to.have.property('groupId');",
							"    pm.expect(jsonData).to.have.property('userId');",
							"    pm.expect(jsonData.role).to.equal('member');",
							"});",
							"",
							"pm.test('Status is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": \"user_new_12345\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/groups/join/{{inviteCode}}"
			}
		},
		{
			"name": "6. Thêm thành viên trực tiếp (admin thêm tay)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"",
							"pm.test('Member added successfully', function () {",
							"    pm.expect(jsonData).to.have.property('groupId');",
							"    pm.expect(jsonData).to.have.property('userId');",
							"    pm.expect(jsonData).to.have.property('role');",
							"});",
							"",
							"pm.test('Status is 201', function () {",
							"    pm.response.to.have.status(201);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": \"user_member_54321\",\n    \"role\": \"member\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/groups/{{groupId}}/members"
			}
		},
		{
			"name": "7. Lấy danh sách nhóm của user",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"var currentGroupId = pm.collectionVariables.get('groupId');",
							"",
							"pm.test('Response is array', function () {",
							"    pm.expect(jsonData).to.be.an('array');",
							"});",
							"",
							"if (currentGroupId) {",
							"    pm.test('Groups contain created group', function () {",
							"        var hasGroup = jsonData.some(function(g) { return g.groupId === currentGroupId; });",
							"        pm.expect(hasGroup).to.be.true;",
							"    });",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/groups/user/{{userId}}"
			}
		},
		{
			"name": "8. Lấy danh sách tất cả nhóm",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Response is array', function () {",
							"    pm.expect(pm.response.json()).to.be.an('array');",
							"});",
							"",
							"pm.test('Status is 200', function () {",
							"    pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/groups"
			}
		},
		{
			"name": "9. Test lỗi - Invite code không hợp lệ",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"",
							"pm.test('Error for invalid invite code', function () {",
							"    pm.expect(jsonData.message).to.include('Invalid');",
							"});",
							"",
							"pm.test('Status is 404', function () {",
							"    pm.response.to.have.status(404);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": \"user_invalid_99999\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/groups/join/INVALID123"
			}
		},
		{
			"name": "10. Test lỗi - User đã là thành viên",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"",
							"pm.test('Error for duplicate member', function () {",
							"    pm.expect(jsonData.message).to.include('already');",
							"});",
							"",
							"pm.test('Status is 400', function () {",
							"    pm.response.to.have.status(400);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"userId\": \"user_new_12345\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/groups/join/{{inviteCode}}"
			}
		},
		{
			"name": "11. Test lỗi - Group không tồn tại",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status is 404 for non-existent group', function () {",
							"    pm.response.to.have.status(404);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{jwtToken}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/groups/nonexistent_group_999"
			}
		}
	]
}
